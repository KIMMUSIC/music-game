{
  "name": "music-quiz-game-backend",
  "version": "0.0.1",
  "description": "Music Quiz Game Platform - Backend Services",
  "private": true,
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start:dev": "npm run start:dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "eslint \"{services,shared}/**/*.ts\"",
    "lint:fix": "eslint \"{services,shared}/**/*.ts\" --fix",
    "format": "prettier --write \"{services,shared}/**/*.ts\""
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-kakao": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
